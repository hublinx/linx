# ===== BẮT BUỘC =====
TELEGRAM_BOT_TOKEN=123456789:ABCdefYourBotTokenFromBotFather
# Nhiều chat: cách nhau dấu phẩy. Group/channel có dạng -100xxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
OPENAI_API_KEY=sk-...

# ===== OPENAI =====
OPENAI_MODEL=gpt-5-mini
# Chỉ dùng cho model reasoning (gpt-5*, o*): minimal | low | medium | high
OPENAI_REASONING_EFFORT=
# Endpoint tương thích OpenAI (OpenAI gốc, OmniRoute, LiteLLM...). VD OmniRoute: https://omni.mease.asia/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=120000
# TELEGRAM_THREAD_ID=   # topic trong supergroup (tùy chọn)

# ===== BINANCE =====
SYMBOLS=BTCUSDT,ETHUSDT
# futures (có OI, funding, long/short, taker) | spot
BINANCE_MARKET=futures
# BINANCE_FUTURES_URL=https://fapi.binance.com
# BINANCE_SPOT_URL=https://api.binance.com

# ===== LỊCH CHẠY =====
INTERVAL_MINUTES=5
# chạy sau khi nến đóng N giây (10:05:05, 10:10:05, ...)
RUN_DELAY_SECONDS=5
# false = chỉ gửi khi có lệnh mới hoặc lệnh cũ chạm TP/SL
SEND_NO_TRADE=true
# short = gọn (Entry/TP/SL + 1 dòng giải thích) | full = chi tiết
MESSAGE_STYLE=short

# ===== BỘ LỌC CHẶT CHẼ (lệnh vi phạm sẽ bị hạ xuống KHÔNG VÀO LỆNH) =====
# độ tin cậy tối thiểu AI tự chấm
MIN_CONFIDENCE=70
# điểm hợp lưu kỹ thuật tối thiểu (0-100) của phía vào lệnh
MIN_CONFLUENCE=60
# phía vào lệnh phải hơn phía ngược lại ít nhất N điểm
MIN_SCORE_GAP=15
MIN_RR_TP1=1.0
MIN_RR_TP3=2.0
# SL tối thiểu = 0.5 x ATR(5m)
MIN_SL_ATR=0.5
# SL tối đa = 2.5 x ATR(5m)
MAX_SL_ATR=2.5
# SL tối thiểu theo % giá (tránh SL quá sát bị phí/quét)
MIN_SL_PCT=0.12
# entry không được cách giá hiện tại quá 1 ATR (không đuổi giá)
MAX_ENTRY_ATR=1.0

# ===== QUẢN LÝ LỆNH =====
# lệnh LIMIT không khớp sau N phút thì hủy
SIGNAL_VALID_MINUTES=30
# giữ tối đa N phút rồi đóng theo giá
MAX_HOLD_MINUTES=240
# chạm TP1 dời SL về entry, chạm TP2 dời SL về TP1
MOVE_SL_TO_BE=true
# false = đang có lệnh mở thì không phát lệnh mới cùng coin
ALLOW_STACKING=false

# ===== BỘ LỌC BỔ SUNG =====
# không vào lệnh ±N phút quanh giờ chốt funding (07:00, 15:00, 23:00 giờ VN); 0 = tắt
FUNDING_BLACKOUT_MIN=10
# không vào lệnh ±N phút quanh tin kinh tế lớn (CPI, FOMC, NFP...); 0 = tắt
NEWS_BLACKOUT_MIN=15
NEWS_COUNTRIES=USD
# NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# altcoin đi theo BTC: không LONG ETH khi BTC giảm (5m + 15m) và ngược lại
BTC_FILTER=true
# phí khứ hồi % (maker 0.02 + taker 0.05 ≈ 0.07-0.1)
FEE_PCT=0.08
# R:R tối thiểu của TP1 SAU phí
MIN_RR_TP1_NET=0.8
# model AI thứ 2 phải đồng ý mới vào lệnh (để trống = tắt, tốn gấp đôi phí AI)
AI_CONFIRM_MODEL=
# giờ gửi báo cáo ngày (theo DISPLAY_TZ), -1 = tắt
DAILY_REPORT_HOUR=21

DATA_DIR=./data
DISPLAY_TZ=Asia/Ho_Chi_Minh
