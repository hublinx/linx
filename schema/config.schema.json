{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/hublinx/linx/main/schema/config.schema.json",
    "title": "linx project config (.linx/config.json)",
    "type": "object",
    "properties": {
        "$schema": { "type": "string" },
        "baseBranch": { "type": "string", "description": "Branch to start work from and to target PRs/MRs at." },
        "forge": { "enum": ["github", "gitlab", "none"] },
        "docsLanguage": { "type": "string", "description": "Language for spec, plan, progress and PR/MR text." },
        "paths": {
            "type": "object",
            "properties": {
                "work": { "type": "string", "description": "Work items folder; may be outside the repo." },
                "knowledge": { "type": "string" }
            },
            "additionalProperties": false
        },
        "smallTaskMaxFiles": { "type": "integer", "minimum": 1 },
        "escalation": { "type": "array", "items": { "type": "string" } },
        "verify": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "cmd"],
                "properties": {
                    "name": { "type": "string", "pattern": "^[\\w-]+$" },
                    "cmd": { "type": "string" },
                    "baseline": { "enum": ["tsc", "eslint-json", "ruff-json"] },
                    "default": { "type": "boolean" }
                },
                "additionalProperties": false
            }
        },
        "review": {
            "type": "object",
            "properties": { "checklist": { "type": "array", "items": { "type": "string" } } }
        },
        "sensitivePaths": { "type": "array", "items": { "type": "string", "format": "regex" } },
        "format": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "object",
                    "required": ["command"],
                    "properties": {
                        "command": { "type": "string", "pattern": "\\{file\\}" },
                        "extensions": { "type": "array", "items": { "type": "string" } }
                    }
                }
            ]
        },
        "repos": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "path"],
                "properties": { "name": { "type": "string" }, "path": { "type": "string" } }
            }
        }
    }
}
