{
    "description": "linx: workflow reminder + unfinished work at session start; formatter and sensitive-file warning after edits.",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"" }]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-edit.mjs\"" }]
            }
        ]
    }
}
